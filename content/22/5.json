 "neAnlatiyor": [
  "Bu ayet, önceki ayetlerde tanıtılan kıyametin dehşetinden sonra, dirilişten kuşku duyanlara kendi yaratılışlarını hatırlatır. İnsanın toprak, damla, kan pıhtısı ve et parçası aşamalarından geçerek yaratılması, aynı gücün yeniden diriltmeye de yeteceğinin bir kanıtı olarak sunulur. Doğum, büyüme, olgunluk ve yaşlılık evrelerinin sayılması, hayatın her aşamasının bir düzen içinde ilerlediğini gösterir.",
  "Ayetin sonundaki kuru toprağın yağmurla canlanması örneği, aynı dirilişin bir benzetmesidir: nasıl ölü toprak suyla yeniden hareketlenip bitki çıkarıyorsa, ölü bedenler de aynı şekilde yeniden diriltilebilir. Klasik tefsir bu ayeti, dirilişi gözlemle temellendiren bir delil ayeti olarak açıklar."
 ],
 "kuraniKurana": [
  {
   "ref": "23:14",
   "meal": "Sonra o damlayı bir kan pıhtısı yaptık, kan pıhtısını bir et parçası yaptık, onu kemiklere dönüştürdük, kemiklere de et giydirdik; sonra onu başka bir yaratılışla inşa ettik. Yaratanların en güzeli olan Allah ne yücedir.",
   "baglanti": "22:5'teki nutfe-alaka-mudga aşamaları burada daha ayrıntılı anlatılır; aynı yaratılış süreci iki surede de delil olarak sunulur."
  },
  {
   "ref": "30:19",
   "meal": "Ölüden diriyi çıkarır, diriden ölüyü çıkarır ve yeryüzünü ölümünden sonra diriltir; işte siz de böyle çıkarılacaksınız.",
   "baglanti": "Kuru toprağın yağmurla canlanması burada da dirilişe delil gösterilir; 22:5'in son cümlesiyle aynı benzetmeyi paylaşır."
  }
 ],
 "gunlukHayat": [
  "Ayetin doğrudan konusu insanın yaratılış aşamaları ve bunun dirilişe delil oluşudur; bilimsel bir açıklama değil, imanı pekiştiren bir hatırlatmadır.",
  "Hayatın her aşamasının (çocukluk, olgunluk, yaşlılık) bir düzen içinde ilerlediğini görmek, bulunduğun yaş dönemini kabullenmeyi ve elindeki zamanı boşa harcamamayı hatırlatabilir."
 ],
