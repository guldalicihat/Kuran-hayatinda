 "neAnlatiyor": [
  "34. ayetteki 'açıklayıcı ayetler' vurgusundan sonra, bu ayette Allah'ın nûru mecazi bir temsille anlatılır: kandillik, cam, zeytin ağacından gelen parlak yağ, nûr üstüne nûr. Klasik tefsir bu temsili, hidayetin katman katman aydınlanması olarak açıklar; ayrıntılara girmeden genel çerçeve aktarılmıştır.",
  "Ayetin sonu, bu nûrun herkese eşit ulaşmadığını, Allah'ın dilediğini kendi nûruna yönelttiğini belirtir. Bu, sonraki ayetlerde (36-37) anlatılacak, Allah'ı anan ve tesbih eden kimselerin bu nûrdan pay aldığını gösteren bir geçiş niteliği taşır."
 ],
 "kuraniKurana": [
  {
   "ref": "6:1",
   "meal": "Hamd, gökleri ve yeri yaratan, karanlıkları ve nûru var eden Allah'a mahsustur.",
   "baglanti": "Karanlık ve nûrun ikisinin de Allah'ın yaratması olduğunu belirterek, 24:35'teki nûr vurgusuna kaynak bir çerçeve sunar."
  },
  {
   "ref": "57:28",
   "meal": "Ey iman edenler! Allah'a karşı gelmekten sakının ve Peygamber'ine iman edin ki size rahmetinden iki pay versin ve size kendisiyle yürüyeceğiniz bir nûr versin.",
   "baglanti": "Allah'ın müminlere bir 'nûr' bahşetmesi, 24:35'teki 'Allah dilediğini kendi nûruna yöneltir' ifadesinin somut bir örneğidir."
  }
 ],
 "gunlukHayat": [
  "Ayetin doğrudan konusu, Allah'ın nûrunun mecazi bir temsille anlatılmasıdır; bu, sembolik bir dildir ve harfi harfine bir tasvir değildir.",
  "Bugüne taşınabilecek ders, hidayetin bir bağış olduğunu ve kalbi bu aydınlığa açık tutmanın önemini hatırlamaktır. Kalp, kandillik gibi hazır tutulursa gelen nûru daha iyi alabilir."
 ],
 "bugun": [
