 "neAnlatiyor": [
  "41. ayetteki gök-yer tesbihinin ardından, burada Allah'ın kudreti bulutların oluşumu, yağmur, dolu ve şimşek gibi doğa olaylarıyla somutlaştırılır.",
  "Ayet, bu olayların rastgele değil Allah'ın sevk ve tedbiriyle gerçekleştiğini vurgular; 'dilediğine isabet ettirir, dilediğinden çevirir' ifadesi, doğa olaylarının da bir düzen ve iradeye bağlı olduğunu gösterir."
 ],
 "kuraniKurana": [
  {
   "ref": "30:48",
   "meal": "Allah rüzgârları gönderir, onlar bulutu harekete geçirir; Allah onu gökte dilediği gibi yayar ve parça parça kılar; derken yağmurun arasından çıktığını görürsün.",
   "baglanti": "Bulut oluşumu ve yağmurun çıkışı neredeyse aynı ifadelerle burada da anlatılır; iki ayet birbirini doğrudan tamamlar."
  },
  {
   "ref": "13:12",
   "meal": "Size korku ve umut olsun diye şimşeği gösteren ve yağmur yüklü bulutları oluşturan O'dur.",
   "baglanti": "Şimşek ve bulutun birlikte anılması, 24:43'teki tasviri destekleyen ve korku-umut boyutunu ekleyen bir paralel ayettir."
  }
 ],
 "gunlukHayat": [
  "Ayetin doğrudan konusu, bulut, yağmur, dolu ve şimşek gibi doğa olaylarının Allah'ın kudretine işaret etmesidir.",
  "Bugüne taşınabilecek ders, günlük hayatta karşılaşılan hava olaylarını sıradan görmeyip ibret nazarıyla izlemektir."
 ],
