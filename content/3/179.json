 "neAnlatiyor": [
  "Ayet, müminlerin içinde bulunduğu belirsiz durumun -kimin gerçek mümin kimin münafık olduğunun karışık göründüğü hâlin- sürekli kalmayacağını, imtihanlarla temizin murdardan ayrılacağını bildirir.",
  "Gaybın bilgisi insana verilmez; ancak Allah dilediği resûlünü seçip ona bazı bilgiler bildirebilir. Klasik tefsir, bu ayeti münafıkların Uhud'da ortaya çıkmasıyla ilişkilendirir; imtihan gizli olanı görünür kılar."
 ],
 "kuraniKurana": [
  {
   "ref": "29:2",
   "meal": "İnsanlar, 'İman ettik' demekle imtihan edilmeden bırakılacaklarını mı sandılar?",
   "baglanti": "Müminlerin imtihanla ayırt edileceği fikri burada da açıkça ifade edilir."
  },
  {
   "ref": "72:27",
   "meal": "Ancak razı olduğu bir resûl hariç, O gaybını kimseye açık göstermez.",
   "baglanti": "Gaybın yalnız Allah'ın dilediği resûle bildirilebileceği fikri, bu ayetteki 'Allah resûllerinden dilediğini seçer' ifadesiyle örtüşür."
  }
 ],
 "gunlukHayat": [
  "Ayetin doğrudan konusu, iman iddiasının imtihanla sınanacağı ve gaybın insana verilmediğidir.",
  "Bugüne taşınabilecek ders, sözle iddia etmenin yeterli olmadığı, gerçek karakterin zorluk anlarında ortaya çıktığıdır. Bilinmeyeni bilme iddiasından uzak durup elindeki bilgiyle sorumlu davranmak da bu ayetten çıkan bir tutumdur."
 ],
