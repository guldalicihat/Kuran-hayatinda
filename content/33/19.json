  },
  {
   "ref": "47:20",
   "meal": "Kalplerinde hastalık olanları, ölüm baygınlığı geçiren kimsenin bakışı gibi sana baktıklarını görürsün.",
   "baglanti": "Neredeyse birebir aynı imgeyle, korku anındaki bakışı başka bir sureden tasvir eder."
  }
 ],
