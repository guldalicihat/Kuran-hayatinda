 "neAnlatiyor": [
  "Ayet, müminler arasındaki alay etmeyi, ayıplamayı ve kötü lakap takmayı açıkça yasaklar. 'Yeshar' kökü alay etmeyi, küçümsemeyi; 'telmizû' kökü ise kusur bulup ayıplamayı anlatır.",
  "Ayetin 'belki onlar kendilerinden daha hayırlıdır' ifadesi, alay edilen kişinin Allah katındaki değerinin bilinemeyeceğini hatırlatır. İmandan sonra fasıklıkla anılmak ağır bir uyarıyla nitelenir; tövbe etmeyenler için 'zalimler' ifadesi kullanılır."
 ],
 "kuraniKurana": [
  {
   "ref": "104:1",
   "meal": "Arkadan çekiştirip yüzden alay eden herkesin vay haline!",
