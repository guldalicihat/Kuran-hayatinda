 "neAnlatiyor": [
  "Ayet, hac ve umre ile ilgili kutsal simgelere -haram ay, kurbanlık hayvanlar, Kâbe'ye yönelenler- saygıyı emreder. Bu simgeler toplumsal güvenliğin ve ibadet düzeninin işaretleridir; onlara saldırı düzeni bozar. İhramdan çıkıldığında avlanma yasağı kalkar.",
  "Ayetin ikinci bölümü, geçmişte Müslümanları Mescid-i Harâm'dan alıkoymuş bir topluluğa duyulan kinin adaletsiz bir misillemeye dönüşmesini engeller. Klasik tefsir bu ayeti, Hudeybiye döneminde yaşanan gerilimle ilişkilendirir. Ayet, iyilik ve takvada yardımlaşmayı, günah ve düşmanlıkta yardımlaşmamayı genel bir ilke olarak koyar."
 ],
 "kuraniKurana": [
  {
   "ref": "5:8",
   "meal": "Ey iman edenler! Allah için hakkı ayakta tutanlar, adaletle şahitlik edenler olun. Bir topluluğa duyduğunuz kin sizi adaletsizliğe sürüklemesin. Adaletli olun; bu takvaya daha yakındır. Allah'tan korkun; şüphesiz Allah yaptıklarınızdan haberdardır.",
   "baglanti": "Bir topluluğa duyulan kinin adaletsizliğe yol açmaması ilkesi, 8. ayette 'adaletli olun' emriyle neredeyse aynı ifadeyle tekrarlanır."
  },
  {
   "ref": "3:97",
   "meal": "Orada apaçık ayetler, İbrahim'in makamı vardır. Oraya giren güvende olur. Yoluna gücü yetenlerin Beyt'i haccetmesi, insanlar üzerinde Allah'ın bir hakkıdır. Kim inkâr ederse bilsin ki Allah âlemlerden müstağnidir.",
   "baglanti": "Ayetteki 'Beyt-i Haram'a yönelenler' ifadesi, Âl-i İmrân 97'de anlatılan hac yükümlülüğüyle aynı kutsal mekâna işaret eder."
  }
 ],
 "gunlukHayat": [
  "Ayetin doğrudan konusu, hac/umre dönemindeki kutsal simgelere saygı ve geçmiş bir haksızlığa orantısız tepki vermemektir; bu özel bir tarihsel bağlamı olan bir hükümdür.",
  "Buradan çıkan genel ilke, kızgınlığın adaleti gölgelememesi ve yardımlaşmanın yönünü iyi seçmektir. Bir kişiye kırgın olmak, ona haksızlık etmeyi haklı çıkarmaz; işbirliği ise ancak iyilik ve takva doğrultusunda anlamlıdır."
 ],
 "bugun": [
  {
   "baslik": "Kırgınlığını adaletle sınırla",
   "aciklama": "Sana haksızlık eden biri hakkında karar verirken, kızgınlığının seni orantısız bir tepkiye sürüklemediğinden emin ol."
  },
  {
   "baslik": "Kimle ne konuda yardımlaştığına bak",
   "aciklama": "Bugün katıldığın bir iş birliğinin iyilik mi yoksa zarar mı ürettiğini gözden geçir."
  },
  {
   "baslik": "Kutsal saydığın bir değere saygı göster",
   "aciklama": "Başkalarının önemsediği bir değeri veya alanı bugün bilerek çiğnemekten kaçın."
  }
 ],
 "bugununAdimi": "Bugün, kırgın olduğun bir kişiye karşı adil davranıp davranmadığını gözden geçir ve gerekiyorsa tutumunu düzelt.",
