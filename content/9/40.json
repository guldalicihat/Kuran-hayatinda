 "neAnlatiyor": [
  "Ayet, 38-39. ayetlerdeki sefere çıkma çağrısına uyulmasa bile Allah'ın davasını zaten desteksiz bırakmayacağını, hicret sırasında Mekke'den çıkarılan Peygamber ve yanındaki yoldaşının mağarada sığındığı olayı örnek göstererek anlatır; klasik tefsir bu olayı Mekke'den Medine'ye hicret yolculuğu sırasında yaşanan tarihî bir an olarak açıklar.",
  "Ayetin ana vurgusu, insan desteği azaldığında bile güven ve huzurun (sekîne) Allah'tan geldiğidir; 'üzülme, Allah bizimle beraberdir' sözü zor bir anda dile getirilen bir tevekkül örneğidir ve ayet bunu inkâr edenlerin gücünün karşısında Allah'ın sözünün üstün geleceğine bağlar."
 ],
 "kuraniKurana": [
  {
   "ref": "48:4",
   "meal": "Mü'minlerin imanına iman katsın diye kalplerine güven duygusunu (sekîne) indiren O'dur.",
   "baglanti": "Her iki ayet de aynı 'sekîne' kavramını kullanır; Allah'ın zor anlarda kalplere güven ve huzur indirdiğini anlatır."
  },
  {
   "ref": "3:123",
   "meal": "Andolsun, siz güçsüz iken Allah size Bedir'de yardım etmişti.",
   "baglanti": "Bu ayet de, maddi güç azken Allah'ın yardımının geldiğine dair başka bir tarihî örnektir; 9:40'taki mağara olayıyla aynı temayı paylaşır."
  }
 ],
 "gunlukHayat": [
  "Ayetin doğrudan konusu, tarihî bir hicret olayı ve bu olaydaki ilahî yardımdır; bu savaşa çıkma teşviki değil, zor bir anda yaşanan tevekkül ve güven örneğidir.",
  "Buradan çıkarılabilecek evrensel ders, insan desteği azaldığında ya da yalnız kalındığında bile umutsuzluğa kapılmamak, güç ve huzurun tek kaynağının maddi destek olmadığını bilmektir."
 ],
